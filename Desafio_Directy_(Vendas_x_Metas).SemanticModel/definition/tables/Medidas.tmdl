	measure 'Diferença Atingemento da Meta' = [Meta Total] - [Faturamento Total]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: d7b6976d-5add-469e-8010-4ee8f931f964

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Top 3 - Comparação dos Rankings' =
			
			VAR RankingPeriodo =
			    SELECTCOLUMNS(
			        TOPN(
			            3,
			            ALLSELECTED(Subcategoria[Subcategoria]),
			            [Faturamento Total], DESC,
			            Subcategoria[Subcategoria], ASC
			        ),
			        "Nome", Subcategoria[Subcategoria]
			    )
			
			VAR Ranking2018 =
			    SELECTCOLUMNS(
			        TOPN(
			            3,
			            ALLSELECTED(Subcategoria[Subcategoria]),
			            [Faturamento 2018], DESC,
			            Subcategoria[Subcategoria], ASC
			        ),
			        "Nome", Subcategoria[Subcategoria]
			    )
			
			VAR QuantidadeComum =
			    COUNTROWS(
			        INTERSECT(RankingPeriodo, Ranking2018)
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        COUNTROWS(RankingPeriodo) < 3 ||
			        COUNTROWS(Ranking2018) < 3,
			        "Não há 3 subcategorias para comparar",
			        QuantidadeComum = 3,
			        "✅ Mesmas subcategorias no périodo completo.",
			        "Não — apenas " & QuantidadeComum & " de 3 são iguais"
			    )
		lineageTag: fed512e1-6fe4-4674-8c71-9d28e2ce3d5f

	measure 'Participação Desktops (%)' =
			
			DIVIDE(
			    CALCULATE(
			        [Faturamento Total],
			        Subcategoria[Subcategoria] = "Desktops"
			    ),
			    CALCULATE(
			        [Faturamento Total],
			        REMOVEFILTERS(Subcategoria),
			        REMOVEFILTERS(DimCategoria)
			    ),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8f2aaff8-3360-47eb-b781-886084b46a50

	measure 'Faturamento até 16 Março' =
			
			VAR AnoSelecionado =
			    SELECTEDVALUE(DimAno[Ano])
			RETURN
			    CALCULATE(
			        [Faturamento Total],
			        REMOVEFILTERS(Calendario),
			        DATESBETWEEN(
			            Calendario[Date],
			            DATE(AnoSelecionado, 1, 1),
			            DATE(AnoSelecionado, 3, 16)
			        )
			    )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 6906463b-326c-49e4-8342-ae157a0104c6

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Variação Faturamento 2018 x 2019 (%)' = DIVIDE([Faturamento 2019] - [Faturamento 2018], [Faturamento 2018], 0)
		lineageTag: d17c24b4-1a52-49d4-9a56-5791846b7003

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Variação Representatividade Desktops (%)' =
			
			VAR Participacao2017 =
			    CALCULATE(
			        [Participação Desktops (%)],
			        DimAno[Ano] = 2017
			    )
			VAR Participacao2018 =
			    CALCULATE(
			        [Participação Desktops (%)],
			        DimAno[Ano] = 2018
			    )
			RETURN
			    DIVIDE(
			        Participacao2018 - Participacao2017,
			        Participacao2017,
			        0
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b1fe5c10-615d-4592-9cf4-990e2317bd10

	partition Medidas = m
		mode: import
		source =
				let
				    Fonte = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Coluna 1" = _t]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"Coluna 1", type text}}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Tipo Alterado",{{"Coluna 1", "Metas"}}),
				    #"Colunas Removidas" = Table.RemoveColumns(#"Colunas Renomeadas",{"Metas"})
				in
				    #"Colunas Removidas"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navegação

