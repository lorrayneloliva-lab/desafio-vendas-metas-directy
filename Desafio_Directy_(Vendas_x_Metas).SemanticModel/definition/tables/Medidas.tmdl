	measure 'Meta 2019' = CALCULATE([Meta Total], DimAno[Ano] = 2019)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 667f39bc-dea3-47c1-b358-b405844ba143

