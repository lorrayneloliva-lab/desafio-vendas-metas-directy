	measure 'Atingimento da Meta 2017 (%)' = DIVIDE([Faturamento 2017],[Meta 2017],0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f54ebe58-5717-4f53-9bdf-a2ff49122d31

	measure 'Atingimento da Meta 2018 (%)' = DIVIDE([Faturamento 2018],[Meta 2018],0)
		formatString: 0.00%;-0.00%;0.00%
