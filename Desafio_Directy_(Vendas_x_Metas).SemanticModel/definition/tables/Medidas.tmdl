			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a44ce04f-961e-439b-8fdb-67f17efee8b8

	measure 'Meta 2018' = CALCULATE([Meta Total], DimAno[Ano] = 2018)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 92ec4ae4-7e7d-4636-ac52-c08f871385c4

